# Configuration ABMCY Core pour SHOP PRO
# Copier ce fichier vers .env et remplir avec vos valeurs réelles.
# Ne jamais committer le fichier .env (voir .gitignore).

# URL de l'API ABMCY (ne pas modifier sauf si nécessaire)
VITE_ABMCY_API_URL=https://api.abmcy.com

# Clé API tenant (fournie par ABMCY à la création du compte)
# Trouvable dans votre dashboard ABMCY — laisser vide tant que le tenant
# "shop-pro" n'a pas été créé côté backend (business_type conseillé :
# commerce_general — vêtements prêts-à-porter + sur-mesure, pas de couture
# haute couture ni de tissus/mesures type HANI'S).
VITE_ABMCY_API_KEY=

# Slug du tenant (identifiant unique du compte)
VITE_ABMCY_TENANT_SLUG=shop-pro
